{
  "name": "Panier",
  "short_name": "Panier",
  "description": "A private, collaborative shopping list",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#111513",
  "theme_color": "#111513",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
